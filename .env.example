# Copy to .env and fill in. Never commit .env.

# --- Core ---
ANTHROPIC_API_KEY=
# Only needed for keys that are not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
# Case agent and judge models
CASE_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-opus-5-5
# Pre-submit critic: CRITIC=on|off (default off; --critic on|off on pnpm cases wins) and its model
CRITIC=
CRITIC_MODEL=claude-opus-5-5
# Optional cap on in-flight LLM requests per model (unset = no cap)
LLM_CONCURRENCY=

# --- Cursor SDK judge (offline grading only; never used by the case agent) ---
# Cursor Dashboard -> Integrations. Used when the judge model is "cursor:<id>" (pnpm eval --model cursor:composer-2.5, pnpm loop --profile cursor)
CURSOR_API_KEY=
# Model for pnpm loop --profile cursor (default composer-2.5)
CURSOR_JUDGE_MODEL=

# --- Organiser tool API (only if the organisers supply one at the Reality Test; leave empty otherwise) ---
# Set: mapped tool calls go to POST {URL}/tools/<name>; writes are mirrored on the local mock for read-back;
# the first failure (network, timeout, HTTP >= 400, non-JSON) switches the whole run back to the mock.
ORGANISER_API_URL=
# Sent as "Authorization: Bearer <key>"; never logged or written to outputs
ORGANISER_API_KEY=
# http (default; the only transport in this build)
ORGANISER_API_TRANSPORT=
# JSON, e.g. {"send_message":{"tool":"send_email","route":"POST /emails","args":{"body":"text"}},"add_note":null}
ORGANISER_TOOL_MAP=

# --- TypeSafe Jev (fast classifier for pre-screen and pre-send message checks) ---
TYPESAFE_API_KEY=
# USE_JEV=0 to disable; JEV_BLOCK_THRESHOLD=0.8
