# Copy to .env and fill in. Never commit .env.

# --- Core ---
ANTHROPIC_API_KEY=
# Only needed for keys that are not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
# Case agent and judge models
CASE_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-opus-5-5
# Optional cap on in-flight LLM requests per model (unset = no cap)
LLM_CONCURRENCY=

# --- TypeSafe Jev (fast classifier for pre-screen and pre-send message checks) ---
TYPESAFE_API_KEY=
# USE_JEV=0 to disable; JEV_BLOCK_THRESHOLD=0.8
