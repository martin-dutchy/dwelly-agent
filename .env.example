# Copy to .env and fill in. Never commit .env.

# --- Core ---
ANTHROPIC_API_KEY=
# Only needed for keys that are not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
# Case agent and judge models
CASE_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-opus-5-5
# Pre-submit critic: CRITIC=on|off (default off; --critic on|off on pnpm cases wins) and its model
CRITIC=
CRITIC_MODEL=claude-opus-5-5
# Optional cap on in-flight LLM requests per model (unset = no cap)
LLM_CONCURRENCY=

# --- Cursor SDK judge (offline grading only; never used by the case agent) ---
# Cursor Dashboard -> Integrations. Used when the judge model is "cursor:<id>" (pnpm eval --model cursor:composer-2.5, pnpm loop --profile cursor)
CURSOR_API_KEY=
# Model for pnpm loop --profile cursor (default composer-2.5)
CURSOR_JUDGE_MODEL=

# --- Organiser tool API (only if the organisers supply one at the Reality Test; leave empty otherwise) ---
# Set: mapped tool calls go to POST {URL}/tools/<name>; writes are mirrored on the local mock for read-back;
# the first failure (network, timeout, HTTP >= 400, non-JSON) switches the whole run back to the mock.
ORGANISER_API_URL=
# Sent as "Authorization: Bearer <key>"; never logged or written to outputs
ORGANISER_API_KEY=
# http (default; the only transport in this build)
ORGANISER_API_TRANSPORT=
# JSON, e.g. {"send_message":{"tool":"send_email","route":"POST /emails","args":{"body":"text"}},"add_note":null}
ORGANISER_TOOL_MAP=

# --- TypeSafe Jev (fast classifier for pre-screen and pre-send message checks) ---
TYPESAFE_API_KEY=
# USE_JEV=0 to disable; JEV_BLOCK_THRESHOLD=0.8

# --- Voice (ElevenLabs Agents). `pnpm voice:serve`, expose with `ngrok http $PORT`, then `pnpm voice:sync` ---
PORT=3000
ELEVENLABS_API_KEY=
# (ELEVEN_API_KEY, the LiveKit name, is accepted too)
# Printed by the first `pnpm voice:sync`; set it so later syncs update instead of create
ELEVENLABS_AGENT_ID=
# Optional British voice id; empty uses the ElevenLabs default
ELEVENLABS_VOICE_ID=
# Public https URL of the voice server (ngrok/deploy). ElevenLabs calls our tools and Custom LLM here
PUBLIC_BASE_URL=
# Shared secret ElevenLabs sends as "Bearer <secret>" on tool and Custom LLM calls. Any long random string
VOICE_TOOL_SECRET=
# Optional post-call webhook signing secret (grading also runs without it)
ELEVENLABS_WEBHOOK_SECRET=
# Which brain runs the conversation: native = ElevenLabs-hosted Claude calling our tools as webhooks,
# pi = ElevenLabs Custom LLM pointed at our pi agent. Re-run `pnpm voice:sync` after changing it
VOICE_BRAIN=native
# native brain model (ElevenLabs model id)
ELEVENLABS_LLM=claude-haiku-4-5
# pi brain model (Anthropic model id)
VOICE_PI_MODEL=claude-haiku-4-5
# Agent name used by `pnpm voice:sync` (e.g. "Dwelly tenant line (prod)" for the Fly deployment)
ELEVENLABS_AGENT_NAME=
# Voice test programme (src/voice/DEPLOY.md): Neon Postgres for invites, calls, events and grades.
# Empty = in-memory (local dev only)
DATABASE_URL=
# /admin password (HTTP Basic, any username). Empty = admin only from localhost
ADMIN_PASSWORD=
# Max calls per day across all invites (cost guard)
VOICE_DAILY_CALL_CAP=200
# Imported Twilio number used for outbound test calls from /admin (ElevenLabs phone_number_id)
ELEVENLABS_PHONE_NUMBER_ID=
